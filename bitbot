#!/usr/bin/env bash
#
# BitBot CLI Entry Point
#
# Main router for all BitBot commands
#

set -euo pipefail

# Determine script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export BITBOT_HOME="$SCRIPT_DIR"

# Source utilities
source "${SCRIPT_DIR}/lib/util/helpers.sh"
source "${SCRIPT_DIR}/lib/util/detect.sh"
source "${SCRIPT_DIR}/lib/util/prerequisites.sh"

# Source command handlers
source "${SCRIPT_DIR}/lib/global/bitbot-init.sh"
source "${SCRIPT_DIR}/lib/workspace/bitbot-init.sh"
source "${SCRIPT_DIR}/lib/workspace/bitbot-work.sh"
source "${SCRIPT_DIR}/lib/workspace/bitbot-config.sh"
source "${SCRIPT_DIR}/lib/workspace/bitbot-help.sh"
source "${SCRIPT_DIR}/lib/bitbot-version.sh"

# ============================================================================
# Main Entry Point
# ============================================================================

main() {
    local command="${1:-}"
    shift || true

    # Get current directory
    local cwd
    cwd=$(get_current_directory)

    # Detect context: global (install folder) vs workspace (project folder)
    if [[ "$cwd" == "$BITBOT_HOME" ]]; then
        # GLOBAL CONTEXT: Running from BitBot install folder
        handle_global_context
        return $?
    fi

    # WORKSPACE CONTEXT: Running from project folder
    handle_workspace_context "$command" "$@"
}

# ============================================================================
# Global Context Handler
# ============================================================================

handle_global_context() {
    # Running from BitBot install folder

    if ! is_global_init_needed; then
        # Already initialized - validate environment
        validate_global_environment
    else
        # First run - run global init
        run_global_init
    fi
}

# ============================================================================
# Workspace Context Handler
# ============================================================================

handle_workspace_context() {
    local command="$1"
    shift || true

    local workspace_path
    workspace_path=$(get_current_directory)

    # Check for help/version commands (work anywhere)
    case "$command" in
        help|--help|-h)
            bitbot_help
            return 0
            ;;
        version|--version|-v)
            bitbot_version
            return 0
            ;;
    esac

    # Check if workspace is initialized
    if ! is_workspace_initialized "$workspace_path"; then
        # Workspace not initialized
        handle_uninitialized_workspace "$command" "$workspace_path"
        return $?
    fi

    # Workspace initialized - validate prerequisites for container commands
    case "$command" in
        work|config|vscode|init)
            if ! validate_prerequisites "$command"; then
                return 1
            fi
            ;;
    esac

    # Route to command handler
    route_command "$command" "$workspace_path" "$@"
}

# ============================================================================
# Uninitialized Workspace Handler
# ============================================================================

handle_uninitialized_workspace() {
    local command="$1"
    local workspace_path="$2"

    case "$command" in
        init)
            # Explicit init command
            bitbot_init
            return $?
            ;;
        ""|work)
            # Running bare "bitbot" or "bitbot work" - offer to initialize
            print_warning "Workspace not initialized in: $workspace_path"
            echo ""

            local should_init
            should_init=$(prompt_yes_no "Initialize workspace now?" "yes")

            if [[ "$should_init" == "yes" ]]; then
                bitbot_init
                echo ""
                echo "Workspace initialized! Run 'bitbot work' to start."
                return 0
            else
                echo ""
                echo "To initialize later, run: bitbot init"
                return 4
            fi
            ;;
        *)
            # Other commands require initialized workspace
            print_error "Workspace not initialized. Run 'bitbot init' first."
            return 4
            ;;
    esac
}

# ============================================================================
# Command Router
# ============================================================================

route_command() {
    local command="$1"
    local workspace_path="$2"
    shift 2 || true

    local use_vscode=false

    # Check for vscode modifier
    if [[ "${1:-}" == "vscode" ]]; then
        use_vscode=true
        shift || true
    fi

    case "$command" in
        work)
            bitbot_work "$workspace_path" "$use_vscode"
            ;;
        config)
            bitbot_config "$workspace_path" "$use_vscode"
            ;;
        vscode)
            # vscode command = work mode in VS Code
            bitbot_work "$workspace_path" true
            ;;
        init)
            bitbot_init
            ;;
        help)
            bitbot_help
            ;;
        version)
            bitbot_version
            ;;
        "")
            # No command - default to work mode
            bitbot_work "$workspace_path" "$use_vscode"
            ;;
        *)
            print_error "Unknown command: $command"
            echo ""
            bitbot_help
            return 1
            ;;
    esac
}

# ============================================================================
# Execute Main
# ============================================================================

main "$@"
