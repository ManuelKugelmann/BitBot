{
  "name": "BitBot Config Mode",
  "dockerFile": "Dockerfile",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "root",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.bitbot/internal/container/home/.tmux.conf,target=/root/.tmux.conf,type=bind,readonly",
    "source=${localWorkspaceFolder}/.bitbot/internal/container/home/.config,target=/root/.config,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.bitbot/internal/global/.claude,target=/root/.claude,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.bitbot/internal/global/.claude/CLAUDE.md,target=/root/.claude/CLAUDE.md,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.bitbot/internal/global/.claude/settings.json,target=/root/.claude/settings.json,type=bind,readonly",
    "source=${localWorkspaceFolder}/.bitbot/internal/global/.claude/.credentials.json,target=/root/.claude/.credentials.json,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer,target=/workspace/.devcontainer,type=bind,consistency=cached"
  ],
  "runArgs": [
    "--cpus=4",
    "--memory=8g",
    "--memory-swap=8g",
    "--pids-limit=2048"
  ],
  "$comment": "Config template details - merged with templates/bitbot-base/devcontainer.json",
  "$comment2": "bitbot-base/devcontainer.json + details.devcontainer.json => devcontainer.json",
  "$comment3": "Run: templates/scripts/merge-devcontainer.sh templates/bitbot-config",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.associations": {
          "devcontainer.json": "jsonc",
          "Dockerfile": "dockerfile"
        }
      }
    }
  },
  "$comment_config_mounts": "Config mode: Override .devcontainer mount to RW",
  "postCreateCommand": "npm install -g @devcontainers/cli && echo '✓ DevContainer CLI installed'"
}
