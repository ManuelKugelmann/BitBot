#!/bin/bash
# BitBot Internal Session Manager
# Manages tmux sessions inside the container

set -e

WORKSPACE_NAME=$(basename /workspace)
BASE_SESSION_NAME="bitbot-${WORKSPACE_NAME}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

create_first_session() {
    echo -e "${BLUE}[BitBot]${NC} Creating first tmux session: $BASE_SESSION_NAME"
    
    # Initialize workspace MCP services
    if [ -x "/home/node/scripts/setup-workspace-mcp.sh" ]; then
        echo -e "${BLUE}[BitBot]${NC} Setting up workspace MCP services..."
        /home/node/scripts/setup-workspace-mcp.sh || echo -e "${YELLOW}[BitBot]${NC} Workspace MCP setup completed with warnings"
    fi
    
    # Create new session with Claude window
    tmux new-session -d -s "$BASE_SESSION_NAME" -n "claude" -c /workspace
    
    # Start Claude in the first window with session info
    tmux send-keys -t "$BASE_SESSION_NAME:claude" "clear && echo 'Welcome to BitBot Development Environment' && echo 'Session: $BASE_SESSION_NAME' && echo 'Powered by Claude Code + MCP Services' && echo '' && echo 'Global MCP: http://localhost:8080 | Workspace MCP: http://localhost:9080' && echo '' && echo 'Starting Claude Code...' && echo '' && claude" Enter
    
    # Create additional windows for development
    tmux new-window -t "$BASE_SESSION_NAME" -n "terminal" -c /workspace
    tmux new-window -t "$BASE_SESSION_NAME" -n "git" -c /workspace
    
    # Set default window to claude
    tmux select-window -t "$BASE_SESSION_NAME:claude"
}

attach_to_first_session() {
    echo -e "${BLUE}[BitBot]${NC} Attaching to first session: $BASE_SESSION_NAME"
    exec tmux attach-session -t "$BASE_SESSION_NAME"
}

get_first_session() {
    # Get the first BitBot session for this workspace
    tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^$BASE_SESSION_NAME" | head -1 || echo ""
}

is_session_attached() {
    local session_name="$1"
    if [[ -n "$session_name" ]]; then
        local attached_count=$(tmux list-sessions -F "#{session_name} #{session_attached}" 2>/dev/null | grep "^$session_name " | awk '{print $2}')
        [[ "$attached_count" -gt 0 ]]
    else
        return 1
    fi
}

get_unattached_sessions() {
    # Get all unattached BitBot sessions for this workspace
    local sessions=$(tmux list-sessions -F "#{session_name} #{session_attached}" 2>/dev/null | grep "^$BASE_SESSION_NAME" || true)
    if [[ -n "$sessions" ]]; then
        echo "$sessions" | while read -r session_info; do
            local session_name=$(echo "$session_info" | awk '{print $1}')
            local attached_count=$(echo "$session_info" | awk '{print $2}')
            if [[ "$attached_count" -eq 0 ]]; then
                echo "$session_name"
            fi
        done
    fi
}

has_unattached_sessions() {
    local unattached=$(get_unattached_sessions)
    [[ -n "$unattached" ]]
}

get_next_session_number() {
    local max_num=0
    local sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^$BASE_SESSION_NAME" || true)
    
    if [[ -n "$sessions" ]]; then
        echo "$sessions" | while read -r session; do
            if [[ "$session" == "$BASE_SESSION_NAME" ]]; then
                echo "1"
            elif [[ "$session" =~ ^${BASE_SESSION_NAME}-([0-9]+)$ ]]; then
                echo "${BASH_REMATCH[1]}"
            fi
        done | sort -n | tail -1 | xargs -I {} expr {} + 1 2>/dev/null || echo "2"
    else
        echo "1"
    fi
}

show_resume_menu() {
    local unattached_sessions=($(get_unattached_sessions))
    
    if [[ ${#unattached_sessions[@]} -eq 0 ]]; then
        return 1  # No unattached sessions
    fi
    
    echo
    echo -e "${YELLOW}[BitBot]${NC} Found unattached sessions available to resume:"
    echo
    
    local i=1
    for session in "${unattached_sessions[@]}"; do
        echo "  [$i] $session"
        ((i++))
    done
    
    echo "  [$i] Create new session instead"
    echo "  [q] Quit"
    echo
    
    while true; do
        read -p "Choose an option [1-$i, q]: " choice
        
        if [[ "$choice" == "q" || "$choice" == "Q" ]]; then
            echo "Exiting..."
            exit 0
        elif [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -ge 1 ]] && [[ "$choice" -le ${#unattached_sessions[@]} ]]; then
            # Resume selected session
            local selected_session="${unattached_sessions[$((choice-1))]}"
            echo -e "${BLUE}[BitBot]${NC} Resuming session: $selected_session"
            exec tmux attach-session -t "$selected_session"
        elif [[ "$choice" -eq $i ]]; then
            # Create new session
            return 1
        else
            echo "Invalid option. Please try again."
        fi
    done
}

create_additional_session() {
    local session_number=$(get_next_session_number)
    local session_name
    
    if [[ "$session_number" -eq 1 ]]; then
        session_name="$BASE_SESSION_NAME"
    else
        session_name="$BASE_SESSION_NAME-$session_number"
    fi
    
    echo -e "${BLUE}[BitBot]${NC} Creating additional tmux session: $session_name"
    
    # Create new session with terminal window
    tmux new-session -d -s "$session_name" -n "terminal" -c /workspace
    
    # Create additional windows
    tmux new-window -t "$session_name" -n "claude" -c /workspace
    tmux new-window -t "$session_name" -n "git" -c /workspace
    
    # Start Claude in the claude window
    tmux send-keys -t "$session_name:claude" "clear && echo 'BitBot Additional Session: $session_name' && echo 'Powered by Claude Code + MCP Services' && echo '' && echo 'Starting Claude Code...' && echo '' && claude" Enter
    
    # Set default window to terminal for additional sessions
    tmux select-window -t "$session_name:terminal"
    
    echo -e "${BLUE}[BitBot]${NC} Attaching to additional session: $session_name"
    exec tmux attach-session -t "$session_name"
}

show_session_info() {
    echo -e "${BLUE}[BitBot]${NC} Session Manager for workspace: $WORKSPACE_NAME"
    echo
    echo "Available tmux commands:"
    echo "  Ctrl+B, D       - Detach from session"
    echo "  Ctrl+B, C       - Create new window"
    echo "  Ctrl+B, N       - Next window"
    echo "  Ctrl+B, P       - Previous window"
    echo "  tmux-list       - List all sessions"
    echo
}

# Main execution
case "${1:-auto}" in
    "auto"|"")
        # Default behavior: attach to first session, offer resume, or create additional
        show_session_info
        
        FIRST_SESSION=$(get_first_session)
        if [[ -n "$FIRST_SESSION" ]]; then
            # Check if first session is already attached
            if is_session_attached "$FIRST_SESSION"; then
                echo -e "${YELLOW}[BitBot]${NC} First session ($FIRST_SESSION) is already in use"
                
                # Check for unattached sessions to resume
                if has_unattached_sessions; then
                    if ! show_resume_menu; then
                        # User chose to create new session or no menu shown
                        echo -e "${BLUE}[BitBot]${NC} Creating additional session..."
                        create_additional_session
                    fi
                    # If menu was shown and user selected a session, it will have attached already
                else
                    echo -e "${BLUE}[BitBot]${NC} Creating additional session..."
                    create_additional_session
                fi
            else
                # Attach to existing first session
                attach_to_first_session
            fi
        else
            # Check for any unattached sessions before creating first session
            if has_unattached_sessions; then
                echo -e "${BLUE}[BitBot]${NC} No first session found, but unattached sessions exist"
                if ! show_resume_menu; then
                    # User chose to create new session
                    echo -e "${BLUE}[BitBot]${NC} Creating first session..."
                    create_first_session
                    attach_to_first_session
                fi
            else
                # Create and attach to first session
                create_first_session
                attach_to_first_session
            fi
        fi
        ;;
    "interactive")
        # Use the existing tmux-session.sh for interactive menu
        /home/node/scripts/tmux-session.sh interactive
        ;;
    "create")
        # Force create new session
        /home/node/scripts/tmux-session.sh new
        ;;
    "list")
        # List all sessions
        /home/node/scripts/tmux-session.sh list
        ;;
    "attach")
        # Attach to first session if available, offer resume, or create additional
        FIRST_SESSION=$(get_first_session)
        if [[ -n "$FIRST_SESSION" ]]; then
            if is_session_attached "$FIRST_SESSION"; then
                echo -e "${YELLOW}[BitBot]${NC} First session ($FIRST_SESSION) is already in use"
                
                # Check for unattached sessions to resume
                if has_unattached_sessions; then
                    if ! show_resume_menu; then
                        # User chose to create new session
                        echo -e "${BLUE}[BitBot]${NC} Creating additional session..."
                        create_additional_session
                    fi
                else
                    echo -e "${BLUE}[BitBot]${NC} Creating additional session..."
                    create_additional_session
                fi
            else
                attach_to_first_session
            fi
        else
            # Check for any unattached sessions before creating first session
            if has_unattached_sessions; then
                echo -e "${BLUE}[BitBot]${NC} No first session found, but unattached sessions exist"
                if ! show_resume_menu; then
                    # User chose to create new session
                    echo -e "${YELLOW}[BitBot]${NC} Creating first session..."
                    create_first_session
                    attach_to_first_session
                fi
            else
                echo -e "${YELLOW}[BitBot]${NC} No existing session found. Creating first session..."
                create_first_session
                attach_to_first_session
            fi
        fi
        ;;
    "force-attach")
        # Force attach to first session even if already attached
        FIRST_SESSION=$(get_first_session)
        if [[ -n "$FIRST_SESSION" ]]; then
            echo -e "${BLUE}[BitBot]${NC} Force attaching to first session: $FIRST_SESSION"
            attach_to_first_session
        else
            echo -e "${YELLOW}[BitBot]${NC} No existing session found. Creating first session..."
            create_first_session
            attach_to_first_session
        fi
        ;;
    "info")
        show_session_info
        FIRST_SESSION=$(get_first_session)
        if [[ -n "$FIRST_SESSION" ]]; then
            local attached_status="detached"
            if is_session_attached "$FIRST_SESSION"; then
                attached_status="attached"
            fi
            echo "First session: $FIRST_SESSION ($attached_status)"
        else
            echo "First session: None"
        fi
        echo "All BitBot sessions:"
        local sessions=$(tmux list-sessions -F "#{session_name} #{session_attached}" 2>/dev/null | grep "^$BASE_SESSION_NAME" || true)
        if [[ -n "$sessions" ]]; then
            echo "$sessions" | while read -r session_info; do
                local session_name=$(echo "$session_info" | awk '{print $1}')
                local attached_count=$(echo "$session_info" | awk '{print $2}')
                local status="detached"
                [[ "$attached_count" -gt 0 ]] && status="attached"
                echo "  $session_name ($status)"
            done
        else
            echo "  No active sessions"
        fi
        ;;
    *)
        echo "BitBot Session Manager"
        echo "Usage: bitbot [auto|interactive|create|list|attach|force-attach|info]"
        echo "  auto         - Attach to first session or create additional if busy (default)"
        echo "  interactive  - Show interactive session menu"
        echo "  create       - Create a new session"
        echo "  list         - List all workspace sessions"
        echo "  attach       - Attach to first session or create additional if busy"
        echo "  force-attach - Force attach to first session even if already attached"
        echo "  info         - Show session information"
        ;;
esac