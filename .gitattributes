# Ensure bash scripts always have LF line endings
*.sh text eol=lf
*.bash text eol=lf

# BitBot bash launcher (no extension)
test-windows-launch/scripts/bitbot text eol=lf

# Ensure PowerShell scripts have CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Claude tools should always have LF
.claude/tools/** text eol=lf
