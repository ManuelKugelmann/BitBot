#!/bin/bash
':' //; exec pwsh -NoProfile -File "$0" "$@"; exit $?
# BitBot - Universal Development Environment Launcher
# Polyglot script that runs on both Unix/Linux and Windows PowerShell

# Bash section (Unix/Linux/WSL)
if [ -n "$BASH_VERSION" ]; then
    set -e
    
    # Get script directory for fallback path detection
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    
    # Execute shared BitBot core logic
    source "$SCRIPT_DIR/bitbot-core.sh"
    exit $?
fi

: '
# PowerShell section (Windows)

# Check if we have bash available (WSL or Git Bash)
try {
    bash --version | Out-Null
} catch {
    Write-Host "[ERROR] Bash is required but not found. Please install WSL2 or Git for Windows." -ForegroundColor Red
    Write-Host ""
    Write-Host "Options:"
    Write-Host "1. Install WSL2: https://docs.microsoft.com/en-us/windows/wsl/install"
    Write-Host "2. Install Git for Windows: https://git-scm.com/download/win"
    Read-Host "Press Enter to continue"
    exit 1
}

# Get script directory
$SCRIPT_DIR = Split-Path -Parent $MyInvocation.MyCommand.Definition

# Convert script directory to Unix-style for bash
$UNIX_SCRIPT_DIR = $SCRIPT_DIR -replace '\\', '/'
if ($SCRIPT_DIR -match '^[A-Z]:') {
    $Drive = $SCRIPT_DIR.Substring(0,1).ToLower()
    $PathPart = $SCRIPT_DIR.Substring(2) -replace '\\', '/'
    $UNIX_SCRIPT_DIR = "/mnt/$Drive$PathPart"
}

# Execute shared BitBot core logic via bash with Windows platform info
$bashCommand = "export OS='Windows_NT' && export WINDIR='$env:WINDIR' && source '$UNIX_SCRIPT_DIR/bitbot-core.sh'"
bash -c $bashCommand
exit $LASTEXITCODE
'