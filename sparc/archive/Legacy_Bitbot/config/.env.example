# MCP Services Configuration Template
# Copy this file to .env and update with your actual values

# Registry Configuration
REGISTRY_PORT=8080
MCP_NETWORK=mcp-network

# Placeholder MCP Configuration
PLACEHOLDER_MCP_PORT=3000

# Future MCP Services (uncomment and configure as needed)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890

# ANTHROPIC_API_KEY=your_anthropic_api_key
# OPENAI_API_KEY=your_openai_api_key

# GitHub Integration
# GITHUB_TOKEN=your_github_token

# Database Configuration (for future memory/RAG services)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=mcp_services
# POSTGRES_USER=mcp_user
# POSTGRES_PASSWORD=secure_password

# Redis Configuration (for caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=secure_redis_password