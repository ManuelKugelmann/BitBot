{
  "name": "BitBot Dev Environment",
  "dockerComposeFile": "./docker-compose.yml",
  "service": "dotnet-dev", 
  "workspaceFolder": "/workspace",
  "containerEnv": {
    "WORKSPACE_HASH": "${WORKSPACE_HASH}"
  },
  "postCreateCommand": "echo 'BitBot environment initializing...' && /home/node/scripts/setup-workspace-mcp.sh && echo 'BitBot environment ready! Use: bitbot' && bitbot info",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "bitbot": {
            "path": "bash", 
            "args": ["-c", "bitbot"],
            "icon": "robot"
          }
        }
      },
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-vscode.vscode-json",
        "ms-vscode-remote.remote-containers",
        "ms-python.python"
      ]
    }
  },
  "overrideCommand": false,
  "shutdownAction": "none",
  "mounts": [
    "source=${localWorkspaceFolder}/.bitbot,target=/workspace/.bitbot,type=bind,consistency=cached"
  ],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": false
    }
  }
}