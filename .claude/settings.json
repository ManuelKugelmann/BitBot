{
  "hooks": {
    "SessionStart": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": ".claude/hooks/session-start.sh",
                    "timeout": 5000
                }
            ]
        }
    ],
    "UserPromptSubmit": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": ".claude/hooks/fix-and-check.sh",
                    "timeout": 10000
                }
            ]
        }
    ],
    "Stop": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": ".claude/hooks/do-not-stop.sh",
                    "timeout": 5000
                },
                {
                    "type": "command",
                    "command": ".claude/hooks/restart-handler.sh",
                    "timeout": 5000
                }
            ]
        }
    ]
  },

  "permissions": {
    "allow": [
      ".claude/tools/**"
    ]
  }
}
