FROM mcr.microsoft.com/dotnet/sdk:8.0

ARG TZ
ENV TZ="${TZ}"

ARG CLAUDE_CODE_VERSION=latest

# Install basic development tools and network utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    less \
    git \
    procps \
    sudo \
    fzf \
    zsh \
    man-db \
    unzip \
    gnupg2 \
    gh \
    curl \
    wget \
    jq \
    nano \
    vim \
    tmux \
    iputils-ping \
    telnet \
    netcat-openbsd \
    dnsutils \
    ca-certificates \
    lsb-release \
    && curl -sL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null \
    && apt-get update && apt-get install -y --no-install-recommends \
    docker-ce-cli \
    docker-compose-plugin \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && groupadd docker || true \
    && dotnet tool install --global dotnet-format \
    && echo 'node version:' $(node -v) \
    && echo 'npm version:' $(npm -v) \
    && echo 'dotnet version:' $(dotnet --version)

ARG USERNAME=node

# Create user and persist bash history
RUN useradd -m -s /bin/bash $USERNAME \
    && usermod -aG docker $USERNAME || true \
    && SNIPPET="export PROMPT_COMMAND='history -a' && export HISTFILE=/commandhistory/.bash_history" \
    && mkdir /commandhistory \
    && touch /commandhistory/.bash_history \
    && chown -R $USERNAME /commandhistory

# Set `DEVCONTAINER` environment variable to help with orientation
ENV DEVCONTAINER=true

# Create workspace, config, and npm directories and set permissions
RUN mkdir -p /workspace /home/node/.claude /home/node/scripts /usr/local/share/npm-global && \
    chown -R node:node /workspace /home/node/.claude /home/node/scripts /usr/local/share/npm-global

# Copy internal scripts
COPY devcontainer-base/bitbot/ /home/node/scripts/
RUN chown -R node:node /home/node/scripts && \
    chmod +x /home/node/scripts/* && \
    ln -s /home/node/scripts/bitbot /usr/local/bin/bitbot

WORKDIR /workspace

# Install git-delta for better git diffs
ARG GIT_DELTA_VERSION=0.18.2
RUN ARCH=$(dpkg --print-architecture) && \
    wget "https://github.com/dandavison/delta/releases/download/${GIT_DELTA_VERSION}/git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb" && \
    sudo dpkg -i "git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb" && \
    rm "git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb"

# Switch to non-root user
USER node

# Install global packages
ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
ENV PATH=$PATH:/usr/local/share/npm-global/bin:/home/node/scripts

# Set the default shell to zsh
ENV SHELL=/bin/zsh

# Set the default editor
ENV EDITOR=nano
ENV VISUAL=nano

# Install zsh-in-docker for better terminal experience
ARG ZSH_IN_DOCKER_VERSION=1.2.0
RUN sh -c "$(wget -O- https://github.com/deluan/zsh-in-docker/releases/download/v${ZSH_IN_DOCKER_VERSION}/zsh-in-docker.sh)" -- \
    -p git \
    -p fzf \
    -a "source /usr/share/doc/fzf/examples/key-bindings.zsh" \
    -a "source /usr/share/doc/fzf/examples/completion.zsh" \
    -a "export PROMPT_COMMAND='history -a' && export HISTFILE=/commandhistory/.bash_history" \
    -x

# Install Claude Code
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

# Add MCP client tools
RUN npm install -g axios chalk

# Set up .NET development environment (conditional - may already exist)
RUN dotnet nuget add source https://api.nuget.org/v3/index.json -n nuget.org || true

# Create helpful aliases and functions
RUN echo 'alias ll="ls -la"' >> /home/node/.zshrc && \
    echo 'alias gs="git status"' >> /home/node/.zshrc && \
    echo 'alias mcp-status="curl -s http://mcp-registry:8080/services | jq ."' >> /home/node/.zshrc && \
    echo 'alias mcp-ping="curl -s http://simple-mcp:3000/ping"' >> /home/node/.zshrc && \
    echo 'alias workspace-mcp-status="curl -s http://localhost:9080/services | jq ."' >> /home/node/.zshrc && \
    echo 'alias workspace-mcp-ping="curl -s http://localhost:9090/ping"' >> /home/node/.zshrc && \
    echo 'alias workspace-mcp="~/scripts/workspace-mcp.sh"' >> /home/node/.zshrc && \
    echo 'alias dotnet-new="dotnet new list"' >> /home/node/.zshrc && \
    echo 'alias tmux-list="tmux list-sessions"' >> /home/node/.zshrc && \
    echo 'alias tmux-attach="tmux attach-session"' >> /home/node/.zshrc

# Set working directory
WORKDIR /workspace

# Default command
CMD ["/bin/zsh"]