{
  "hooks": {
    "SessionStart": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": ".bitbot/hooks/session-start.sh",
                    "timeout": 5000
                }
            ]
        }
    ],
    "SessionEnd": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": ".bitbot/hooks/session-end.sh",
                    "timeout": 5000
                }
            ]
        }
    ],
    "UserPromptSubmit": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": ".bitbot/hooks/user-prompt-submit.sh",
                    "timeout": 10000
                }
            ]
        }
    ],
    "Stop": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": ".bitbot/hooks/do-not-stop.sh",
                    "timeout": 5000
                }
            ]
        }
    ]
  },

  "permissions": {
    "allow": [
      ".claude/tools/**"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force)",
      "Bash(git push -f:*)",
      "Bash(git push -f)",
      "Bash(git push --delete:*)",
      "Bash(git push --delete)",
      "Bash(git push -d:*)",
      "Bash(git push -d)",
      "Bash(git remote remove:*)",
      "Bash(git remote remove)",
      "Bash(git remote rm:*)",
      "Bash(git remote rm)"
    ]
  }
}
