{
  "workspaceFolder": "/workspace",
  "containerEnv": {
    "BITBOT_PROJECT_PATH": "${localWorkspaceFolder}",
    "BITBOT_PROJECT_NAME": "${localWorkspaceFolderBasename}",
    "BITBOT_HOME": "${localEnv:BITBOT_HOME}"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {
      "version": "latest"
    }
  },
  "remoteUser": "root",
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/bitbot,target=/usr/local/bitbot,type=bind,readonly",
    "source=${localEnv:BITBOT_HOME}/container/home/.tmux.conf,target=/root/.tmux.conf,type=bind,readonly"
  ],
  "$comment": "Base template details - merged with templates/shared/base.devcontainer.json",
  "$comment2": "base.devcontainer.json + details.devcontainer.json => devcontainer.json",
  "$comment3": "Run: templates/shared/scripts/merge-devcontainer.sh templates/base",
  "name": "BitBot Basic Environment",
  "dockerFile": "Dockerfile"
}
