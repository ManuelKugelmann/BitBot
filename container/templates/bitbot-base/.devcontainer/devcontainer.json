{
  "$comment": "Base template - provides infrastructure mounts only",
  "$comment_mounts": "Layered mount strategy: workspace copy (Codespaces) + BITBOT_HOME over-mount (local)",

  "name": "BitBot Basic Environment",
  "dockerFile": "Dockerfile",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "root",
  "mounts": [
    "source=${localWorkspaceFolder}/.bitbot/internal/container/home/.tmux.conf,target=/root/.tmux.conf,type=bind,readonly",
    "source=${localWorkspaceFolder}/.bitbot/internal/container/home/.config,target=/root/.config,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.bitbot/internal/global/.claude,target=/root/.claude,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.bitbot/internal/global/.claude/CLAUDE.md,target=/root/.claude/CLAUDE.md,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.bitbot/internal/global/.claude/settings.json,target=/root/.claude/settings.json,type=bind,readonly",
    "source=${localWorkspaceFolder}/.bitbot/internal/global/.claude/.credentials.json,target=/root/.claude/.credentials.json,type=bind,consistency=cached",
    "source=${localEnv:BITBOT_HOME:+${localEnv:BITBOT_HOME}/container/templates/bitbot-base/home/.tmux.conf},target=/root/.tmux.conf,type=bind,readonly",
    "source=${localEnv:BITBOT_HOME:+${localEnv:BITBOT_HOME}/container/templates/bitbot-base/home/.config},target=/root/.config,type=bind,consistency=cached",
    "source=${localEnv:BITBOT_HOME:+${localEnv:BITBOT_HOME}/global/.claude},target=/root/.claude,type=bind,consistency=cached"
  ],
  "runArgs": [
    "--cpus=4",
    "--memory=8g",
    "--memory-swap=8g",
    "--pids-limit=2048"
  ]
}
