{
  "$comment": "BitBot Development template details - merged with templates/bitbot-base/.devcontainer/devcontainer.json",
  "$comment2": "bitbot-base/.devcontainer/devcontainer.json + details.devcontainer.json => devcontainer.json",
  "$comment3": "Run: templates/scripts/merge-devcontainer.sh templates/bitbot-dev",

  "name": "BitBot Development",
  "dockerFile": "Dockerfile",

  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {
      "version": "latest"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "C_Cpp.default.compilerPath": "/usr/bin/x86_64-w64-mingw32-gcc",
        "C_Cpp.default.intelliSenseMode": "gcc-x64"
      }
    }
  },

  "postCreateCommand": "echo '✓ MinGW cross-compiler installed:' && x86_64-w64-mingw32-gcc --version"
}
