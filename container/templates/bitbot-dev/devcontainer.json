{
  "name": "BitBot Development",
  "dockerFile": "Dockerfile",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "root",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer,target=/workspace/.devcontainer,type=bind,readonly",
    "source=${localWorkspaceFolder}/.bitbot/internal/container/home/.tmux.conf,target=/root/.tmux.conf,type=bind,readonly",
    "source=${localWorkspaceFolder}/.bitbot/internal/container/home/.config,target=/root/.config,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.bitbot/internal/global/.claude,target=/root/.claude,type=bind,consistency=cached",
    "source=${localEnv:BITBOT_HOME:${localWorkspaceFolder}/.bitbot/internal}/global/.claude/CLAUDE.md,target=/root/.claude/CLAUDE.md,type=bind,consistency=cached",
    "source=${localEnv:BITBOT_HOME:${localWorkspaceFolder}/.bitbot/internal}/global/.claude/settings.json,target=/root/.claude/settings.json,type=bind,readonly",
    "source=${localEnv:BITBOT_HOME:${localWorkspaceFolder}/.bitbot/internal}/global/.claude/.credentials.json,target=/root/.claude/.credentials.json,type=bind,consistency=cached"
  ],
  "$comment": "BitBot Development template details - merged with templates/shared/base.devcontainer.json",
  "$comment2": "base.devcontainer.json + details.devcontainer.json => devcontainer.json",
  "$comment3": "Run: templates/shared/scripts/merge-devcontainer.sh templates/bitbot-dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "C_Cpp.default.compilerPath": "/usr/bin/x86_64-w64-mingw32-gcc",
        "C_Cpp.default.intelliSenseMode": "gcc-x64"
      }
    }
  },
  "postCreateCommand": "echo '✓ MinGW cross-compiler installed:' && x86_64-w64-mingw32-gcc --version"
}
