{
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {
      "version": "latest"
    }
  },
  "remoteUser": "root",
  "$comment": "Config template details - merged with templates/shared/base.devcontainer.json",
  "$comment2": "base.devcontainer.json + details.devcontainer.json => devcontainer.json",
  "$comment3": "Run: templates/shared/scripts/merge-devcontainer.sh templates/bitbot-config",
  "name": "BitBot Config Mode",
  "dockerFile": "Dockerfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.associations": {
          "devcontainer.json": "jsonc",
          "Dockerfile": "dockerfile"
        }
      }
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ]
}
