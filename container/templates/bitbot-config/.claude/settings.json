{
  "hooks": {
    "SessionStart": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": ".bitbot/hooks/session-start.sh",
                    "timeout": 5000
                }
            ]
        }
    ],
    "SessionEnd": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": ".bitbot/hooks/session-end.sh",
                    "timeout": 5000
                }
            ]
        }
    ],
    "UserPromptSubmit": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": ".bitbot/hooks/user-prompt-submit.sh",
                    "timeout": 10000
                }
            ]
        }
    ],
    "Stop": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": ".bitbot/hooks/do-not-stop.sh",
                    "timeout": 5000
                }
            ]
        }
    ]
  },

  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git push)",
      "Bash(git reset --hard:*)",
      "Bash(git reset --hard)",
      "Bash(git rebase:*)",
      "Bash(git rebase)",
      "Bash(git branch -D:*)",
      "Bash(git branch -D)",
      "Bash(git tag -d:*)",
      "Bash(git tag -d)"
    ]
  }
}
